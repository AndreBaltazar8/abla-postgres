// A program without the subpath: it links no OpenSSL (tools/test-postgres.sh checks), and asking for TLS says what's missing.
import "abla/io"
import "abla/text"
import "../src/postgres.ab"

fun main: int {
    val asked = pgQuery(PgConfig("127.0.0.1", 1, "x", "x", "", 100, 100, "verify-full", "ca.pem"), "SELECT 1")
    println(asked.error)
    if (asked.error.contains("tls subpath")) 0 else 1
}

import "abla/text"
import "../src/postgres.ab"
import "abla/io"
import "abla/process/time"

fun withReadTimeout(config: PgConfig, milliseconds: int): PgConfig = PgConfig(
    config.host, config.port, config.database, config.user, config.password,
    config.connectTimeoutMilliseconds, milliseconds
)

// How long a reply may take: the configured limit, one query's own, and that
// neither cuts off a reply still arriving.
fun timeoutChecks(config: PgConfig): int {
    val quick = pgClient(withReadTimeout(config, 300))
    // Connected already: signing in with SCRAM takes a while of its own.
    if (!quick.query("SELECT 1", []).succeeded) return 100
    var started = monotonicMilliseconds()
    val cut = quick.query("SELECT pg_sleep(1.5)", [])
    var elapsed = monotonicMilliseconds() - started
    if (cut.succeeded || cut.error != "Timed out while reading PostgreSQL query result") {
        eprintln("short limit: ${cut.error}")
        return 101
    }
    if (elapsed < 250 || elapsed > 1200) { eprintln("short limit took $elapsed ms"); return 102 }
    // That query's connection is gone; the client opens another.
    if (quick.query("SELECT 'again' AS state", []).first("state") != "again") return 103
    // One query's own limit, without changing the client's.
    started = monotonicMilliseconds()
    val patient = quick.query("SELECT pg_sleep(1) , 'slow' AS state", [], 3000)
    elapsed = monotonicMilliseconds() - started
    if (!patient.succeeded || patient.first("state") != "slow" || elapsed < 900) {
        eprintln("query limit: ${patient.error} after $elapsed ms")
        return 104
    }
    val still = quick.query("SELECT pg_sleep(1.5)", [])
    quick.close()
    if (still.succeeded) return 105
    // A longer configured limit counts: this used to stop at five seconds whatever it said.
    val longer = pgQuery(withReadTimeout(config, 9000), "SELECT pg_sleep(6), 'long' AS state", [])
    if (!longer.succeeded || longer.first("state") != "long") {
        eprintln("long limit: ${longer.error}")
        return 106
    }
    // Over a query's limit through the other entry points as well.
    if (pgQuery(config, "SELECT pg_sleep(1.5)", [], 300).succeeded) return 107
    if (pgExecute(config, "SELECT pg_sleep(1.5)", [], 300).succeeded) return 108
    val session = pgSessionQuery(config, PgSessionState(), "SELECT pg_sleep(1.5)", [], 300)
    if (session.result.succeeded) return 109
    // A reply that takes many reads isn't a slow one.
    val large = pgQuery(withReadTimeout(config, 300), "SELECT repeat('x', 8000000) AS value", [])
    if (!large.succeeded || large.first("value").size != 8000000) {
        eprintln("large reply: ${large.error}")
        return 110
    }
    // The largest it takes comes through, and past it says why, at once, rather than timing out.
    val largest = pgQuery(withReadTimeout(config, 300), "SELECT repeat('x', 16000000) AS value", [])
    if (!largest.succeeded || largest.first("value").size != 16000000) {
        eprintln("largest reply: ${largest.error}")
        return 111
    }
    val tooLarge = pgQuery(withReadTimeout(config, 60000), "SELECT repeat('x', 17000000) AS value", [])
    if (tooLarge.succeeded || !tooLarge.error.contains("over 16 MiB")) {
        eprintln("oversized reply: ${tooLarge.error}")
        return 112
    }
    0
}

fun main: int {
    val octets: array<int> = []
    var octet = 0
    while (octet < 256) { octets.append(octet); octet = octet + 1 }
    val encoded = pgBytes(octets)
    if (encoded.size != 256 || pgBytes([]) != "" || pgBytes([-1]) != "" || pgBytes([256]) != "") return 201
    octet = 0
    while (octet < 256) { if (encoded[octet] != octet) return 202; octet = octet + 1 }

    val config = pgConfigFromEnvironment()
    val client = pgClient(config)
    val created = client.execute(
        "CREATE TABLE IF NOT EXISTS abla_probe (id bigint PRIMARY KEY, value text NOT NULL)",
        [])
    val written = client.execute(
        "INSERT INTO abla_probe(id, value) VALUES (\$1, \$2) ON CONFLICT (id) DO UPDATE SET value = EXCLUDED.value",
        [pgText("1"), pgText("O'Reilly from Abla")]
    )
    val selected = client.query(
        "SELECT value, NULL::text AS optional FROM abla_probe WHERE id = \$1",
        [pgText("1")]
    )
    val invalid = client.query("SELECT abla_missing_column", [])
    val detailed = client.query("DO $$ BEGIN RAISE EXCEPTION 'abla refused' USING DETAIL = 'abla detail'; END $$", [])
    val afterError = client.query("SELECT 'ready' AS state", [])
    client.close()
    val afterReconnect = client.query("SELECT 'reconnected' AS state", [])
    client.close()
    val firstSession = pgSessionQuery(
        config, PgSessionState(), "SELECT 'first' AS state", []
    )
    val secondSession = pgSessionQuery(
        config,
        firstSession.state,
        "SELECT 'second' AS state",
        []
    )
    val reusableDescriptor = secondSession.state.descriptor
    val sessionConnection = TcpConnection(reusableDescriptor)
    sessionConnection.close()
    val timing = timeoutChecks(config)
    if (timing != 0) return timing
    if (!created.succeeded) {
        eprintln("create failed: ${created.error}")
        10
    } else if (!written.succeeded) {
        eprintln("write failed: ${written.error}")
        20
    } else if (!selected.succeeded) {
        eprintln("select failed: ${selected.error}")
        30
    }
    else if (selected.rows.size != 1) 40
    else if (selected.first("value") != "O'Reilly from Abla") 50
    else if (!selected.rows[0][1].isNull) 60
    else if (invalid.succeeded || invalid.error == "") 70
    else if (detailed.succeeded || detailed.error != "abla refused\nDETAIL: abla detail") {
        eprintln("detail: ${detailed.error}")
        75
    }
    else if (!afterError.succeeded || afterError.first("state") != "ready") 80
    else if (!afterReconnect.succeeded ||
        afterReconnect.first("state") != "reconnected") 90
    else if (!firstSession.result.succeeded ||
        firstSession.result.first("state") != "first" ||
        !secondSession.result.succeeded ||
        secondSession.result.first("state") != "second" ||
        reusableDescriptor < 0) 100
    else 0
}

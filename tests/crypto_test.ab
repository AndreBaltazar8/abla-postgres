import "../src/crypto.ab"

fun main: int {
    val hmac = pgHmacSha256(
        "key",
        "The quick brown fox jumps over the lazy dog"
    )
    val scram = pgScramProof(
        "pencil",
        "n=user,r=rOprNGfwEbeRWgbNEkqO",
        "r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF\$k0,s=W22ZaJ0SNY7soEsUEjb6gQ==,i=4096"
    )
    if (pgHex(pgSha256("")) !=
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855") 10
    else if (pgHex(pgSha256("abc")) !=
        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad") 20
    else if (pgHex(hmac) !=
        "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8") 30
    else if (pgHex(pgPbkdf2Sha256("password", "salt", 1)) !=
        "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b") 40
    else if (pgHex(pgPbkdf2Sha256("password", "salt", 2)) !=
        "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43") 50
    else if (pgBase64Encode("hello") != "aGVsbG8=") 60
    else if (pgBase64Decode("aGVsbG8=") != "hello") 70
    else if (pgHex(pgMd5("")) != "d41d8cd98f00b204e9800998ecf8427e") 80
    else if (pgHex(pgMd5("abc")) != "900150983cd24fb0d6963f7d28e17f72") 90
    else if (!pgConstantTimeEqual("same", "same")) 100
    else if (pgConstantTimeEqual("same", "different")) 110
    else if (pgSecureNonce().size < 20) 120
    else if (pgSaslName("a,b=c") != "a=2Cb=3Dc") 130
    else if (pgMd5PasswordResponse("user", "password", "1234") !=
        "md559fc02283756dd087ac408823be2c0da") 140
    else if (scram.error != "") 150
    else if (scram.clientFinal !=
        "c=biws,r=rOprNGfwEbeRWgbNEkqO%hvYDpWUa2RaTCAfuxFIlj)hNlF\$k0,p=dHzbZapWIk4jUhN+Ute9ytag9zjfMHgsqmmiz7AndVQ=") 160
    else if (scram.serverSignature !=
        "6rriTRBi23WpRR/wtup+mMhUZUn/dB5nLTJRsjl95G4=") 170
    else 0
}

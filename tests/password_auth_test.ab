import "../src/postgres.ab"
import "../src/async.ab"
import "abla/io"
import "abla/fs"
import "abla/process/time"
import "abla/sys/linux/net"
import "abla/sys/linux"
import "abla/sys/linux/process"
import "abla/text"

// PgConfig.passwordAuthentication: a server (or whoever answers in its place) that asks for the password in cleartext or for its MD5
// gets it only under "always", or under the default "verified" when sslmode verified the server's certificate. The server is this program
// run again as a child: it asks each connection for method `argument 1` (3 or 5) and reports, on its output, whether a password came.

trusted fun server(method: int): int {
    val listener=tcpListenAddress(Ipv4SocketAddress("127.0.0.1",0))
    if(listener.descriptor<0) return 3
    println("${listener.localPort()}")
    while(true) {
        val peer=listener.accept()
        if(peer.readWithTimeoutResult(4096,2000).bytes.size>=8) {
            if(method==5) peer.write(pgTypedMessage(82,[0,0,0,5,1,2,3,4]))
            else peer.write(pgTypedMessage(82,[0,0,0,3]))
            val answer=peer.readWithTimeoutResult(4096,1000).bytes
            if(answer.size>0 && answer[0]==112) println("password")
            peer.write(pgTypedMessage(69,[83,70,65,84,65,76,0,77,110,111,0,0]))
        }
        peer.close()
    }
    0
}

var failures = 0

fun check(name: string, ok: bool): void {
    if (!ok) {
        println("FAIL $name")
        failures = failures + 1
    }
    return
}

fun config(port: int, policy: string, mode: string = "disable"): PgConfig =
    PgConfig("127.0.0.1",port,"test","test","secret",500,1000,mode,"","any",passwordAuthentication=policy)

fun blocking(port: int, policy: string): string {
    val client=pgClient(config(port,policy))
    val result=client.query("SELECT 1")
    client.close()
    result.error
}

fun pooled(port: int, policy: string): string {
    var pool=pgPool(config(port,policy),PgPoolOptions(1,1000,200))
    val id=pool.query("SELECT 1")
    var error="no result"
    var loops=0
    var found=false
    while(!found && loops<300) {
        pool.step(10)
        for(item in pool.takeResults()) if(item.id==id) { error=item.result.error; found=true }
        loops=loops+1
    }
    error
}

trusted fun passwordsSeen(ready: string): int {
    var count=0
    for(line in linuxReadFile(ready,65536).split("\n")) if(line.trim()=="password") count=count+1
    count
}

trusted fun round(method: int): void {
    val parent=linuxProcessId()
    val ready="build/password-auth-$method-$parent.ready"
    val child=linuxCommand("/proc/$parent/exe").argument("server").argument("$method").output(ready).start()
    val readyDeadline=linuxMonotonicMilliseconds()+3000
    var port=0
    while(port<=0 && linuxMonotonicMilliseconds()<readyDeadline) { port=pgInt(linuxReadFile(ready,64).split("\n")[0].trim()); if(port<=0) sleep(5) }
    check("server $method started",port>0)
    if(port>0) {
        val refused=blocking(port,"verified")
        check("method $method refused by default over a plain connection: $refused",refused.contains("not verified") && refused.contains("sslmode disable"))
        val never=blocking(port,"never")
        check("method $method refused under never: $never",never.contains("\"never\""))
        val pooledRefused=pooled(port,"verified")
        check("method $method refused by the pool: $pooledRefused",pooledRefused.contains("not verified"))
        sleep(200)
        check("no password reached the server while refusing",passwordsSeen(ready)==0)
        blocking(port,"always")
        sleep(300)
        check("method $method answered under always",passwordsSeen(ready)==1)
    }
    linuxSyscall2(62,child.process,9)
    linuxWaitProcess(child.process)
    Path(ready).remove()
    return
}

trusted fun main: int {
    if(linuxArgument(0)=="server") return server(pgInt(linuxArgument(1)))
    // A verified sslmode allows it; require (encrypted, but anyone may answer) does not; an unknown policy fails closed.
    check("verify-full allows",pgPasswordProblem(PgConfig("h",1,"d","u","p",sslMode="verify-full"),3)=="")
    check("verify-ca allows",pgPasswordProblem(PgConfig("h",1,"d","u","p",sslMode="verify-ca"),5)=="")
    check("require refuses",pgPasswordProblem(PgConfig("h",1,"d","u","p",sslMode="require"),3)!="")
    check("never refuses verify-full",pgPasswordProblem(PgConfig("h",1,"d","u","p",sslMode="verify-full",passwordAuthentication="never"),3)!="")
    check("unknown policy refuses",pgPasswordProblem(PgConfig("h",1,"d","u","p",sslMode="verify-full",passwordAuthentication="yes"),3).contains("Unknown"))
    check("the default is verified",PgConfig("h",1,"d","u","p").passwordAuthentication=="verified")
    round(3)
    round(5)
    if(failures==0) println("ok password authentication")
    if(failures==0) 0 else 1
}

// One program, told by the environment what to ask: an answer over TLS prints "ssl", a plain one "plain", and a refusal its error.
import "abla/io"
import "../src/postgres.ab"
import "../src/tls.ab"

fun main: int {
    pgTlsEnable()
    val base=pgConfigFromEnvironment()
    val config=PgConfig(base.host,base.port,base.database,base.user,base.password,base.connectTimeoutMilliseconds,base.readTimeoutMilliseconds,base.sslMode,base.sslRootCert,base.targetSessionAttrs,pgEnvironment("PG_TEST_HOST_ADDRESS",""))
    val asked = pgQuery(config, "SELECT ssl::text AS ssl FROM pg_stat_ssl WHERE pid=pg_backend_pid()")
    if (!asked.succeeded) {
        println("refused: ${asked.error}")
        return 1
    }
    // The session bridge, as a long-running service keeps it.
    val first = pgSessionQuery(config, PgSessionState(), "SELECT 1::text AS one")
    val second = pgSessionQuery(config, first.state, "SELECT 2::text AS two")
    if (second.result.first("two") != "2") {
        println("the session broke: ${second.result.error}")
        return 1
    }
    println(if (asked.first("ssl") == "true") "ssl" else "plain")
    0
}

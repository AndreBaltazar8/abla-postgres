    3614090360, 3905402710, 606105819, 3250441966,
    4118548399, 1200080426, 2821735955, 4249261313,
    1770035416, 2336552879, 4294925233, 2304563134,
    1804603682, 4254626195, 2792965006, 1236535329,
    4129170786, 3225465664, 643717713, 3921069994,
    3593408605, 38016083, 3634488961, 3889429448,
    568446438, 3275163606, 4107603335, 1163531501,
    2850285829, 4243563512, 1735328473, 2368359562,
    4294588738, 2272392833, 1839030562, 4259657740,
    2763975236, 1272893353, 4139469664, 3200236656,
    681279174, 3936430074, 3572445317, 76029189,
    3654602809, 3873151461, 530742520, 3299628645,
    4096336452, 1126891415, 2878612391, 4237533241,
    1700485571, 2399980690, 4293915773, 2240044497,
    1873313359, 4264355552, 2734768916, 1309151649,
    4149444226, 3174756917, 718787259, 3951481745
]

fun pgMd5Shifts(): array<int> = [
    7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
    5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
    4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
    6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

fun pgMd5(value: string): string {
    val input: array<int> = []
    pgCryptoAppendText(input, value)
    val bitLength = input.size * 8
    input.append(128)
    while (input.size - input.size / 64 * 64 != 56) input.append(0)
    pgCryptoAppendU32Little(input, bitLength)
    input.append(0)
    input.append(0)
    input.append(0)
    input.append(0)
    var state0 = 1732584193
    var state1 = 4023233417
    var state2 = 2562383102
    var state3 = 271733878
    val constants = pgMd5Constants()
    val shifts = pgMd5Shifts()
    var offset = 0
    while (offset < input.size) {
        val words: array<int> = []
        var index = 0
        while (index < 16) {
            words.append(pgCryptoReadU32Little(input, offset + index * 4))
            index = index + 1
        }
        var a = state0
        var b = state1
        var c = state2
        var d = state3
        index = 0
        while (index < 64) {
            var mixed = 0
            var word = 0
            if (index < 16) {
                mixed = bitOr(bitAnd(b, c), bitAnd(pgCryptoNot(b), d))
                word = index
            } else if (index < 32) {
                mixed = bitOr(bitAnd(d, b), bitAnd(pgCryptoNot(d), c))
                word = index * 5 + 1 - (index * 5 + 1) / 16 * 16
            } else if (index < 48) {
                mixed = pgCryptoXor(pgCryptoXor(b, c), d)
                word = index * 3 + 5 - (index * 3 + 5) / 16 * 16
            } else {
                mixed = pgCryptoXor(c, bitOr(b, pgCryptoNot(d)))
                word = index * 7 - index * 7 / 16 * 16
            }
            val nextD = d
            d = c
            c = b
            b = pgCryptoU32(b + pgCryptoRotateLeft(pgCryptoU32(
                a + mixed + constants[index] + words[word]
            ), shifts[index]))
            a = nextD
            index = index + 1
        }
        state0 = pgCryptoU32(state0 + a)
        state1 = pgCryptoU32(state1 + b)
        state2 = pgCryptoU32(state2 + c)
        state3 = pgCryptoU32(state3 + d)
        offset = offset + 64
    }
    val output: array<int> = []
    pgCryptoAppendU32Little(output, state0)
    pgCryptoAppendU32Little(output, state1)
    pgCryptoAppendU32Little(output, state2)
    pgCryptoAppendU32Little(output, state3)
    pgCryptoBytes(output)
}

fun pgConstantTimeEqual(left: string, right: string): bool {
    var difference = bitXor(left.size, right.size)
    var index = 0
    var count = left.size
    if (right.size < count) count = right.size
    while (index < count) {
        difference = bitOr(difference, bitXor(left[index], right[index]))
        index = index + 1
    }
    difference == 0
}

fun pgSecureNonce(): string {
    val random = linuxReadFile("/dev/urandom", 18)
    var result = ""
    if (random.size == 18) {
        val encoded = pgBase64Encode(random)
        var end = encoded.size
        while (end > 0 && encoded[end - 1] == 61) end = end - 1
        result = encoded.slice(0, end)
    }
    result
}

class PgScramProof(
    val clientFinal: string,
    val serverSignature: string,
    val error: string
)

fun pgScramAttribute(message: string, name: int): string {
    var result = ""
    var begin = 0
    while (begin < message.size) {
        var end = begin
        while (end < message.size && message[end] != 44) end = end + 1
        if (end >= begin + 2 && message[begin] == name &&
            message[begin + 1] == 61) {
            result = message.slice(begin + 2, end)
        }
        begin = end + 1
    }
    result
}

fun pgCryptoPositiveInt(value: string): int {
    var result = 0
    var valid = value.size > 0
    var index = 0
    while (valid && index < value.size) {
        val digit = value[index] - 48
        if (digit < 0 || digit > 9) valid = false
        else result = result * 10 + digit
        index = index + 1
    }
    if (valid && result > 0) result else 0
}

fun pgStartsWith(value: string, expected: string): bool {
    var matches = expected.size <= value.size
    var index = 0
    while (matches && index < expected.size) {
        if (value[index] != expected[index]) matches = false
        index = index + 1
    }
    matches
}

fun pgSaslName(value: string): string {
    var result = ""
    var index = 0
    while (index < value.size) {
        if (value[index] == 44) result = "${result}=2C"
        else if (value[index] == 61) result = "${result}=3D"
        else result = "$result${value.slice(index, index + 1)}"
        index = index + 1
    }
    result
}

fun pgScramProof(
    password: string,
    clientFirstBare: string,
    serverFirst: string
): PgScramProof {
    var error = ""
    val clientNonce = pgScramAttribute(clientFirstBare, 114)
    val serverNonce = pgScramAttribute(serverFirst, 114)
    val encodedSalt = pgScramAttribute(serverFirst, 115)
    val iterationText = pgScramAttribute(serverFirst, 105)
    val iterations = pgCryptoPositiveInt(iterationText)
    val salt = pgBase64Decode(encodedSalt)
    if (pgScramAttribute(serverFirst, 109) != "") {
        error = "PostgreSQL SCRAM server requires an unsupported mandatory extension"
    } else if (clientNonce == "" || serverNonce.size <= clientNonce.size ||
        !pgStartsWith(serverNonce, clientNonce)) {
        error = "PostgreSQL SCRAM server returned an invalid nonce"
    } else if (encodedSalt == "" || salt == "") {
        error = "PostgreSQL SCRAM server returned an invalid salt"
    } else if (iterations < 4096 || iterations > 1000000) {
        error = "PostgreSQL SCRAM iteration count is outside the supported secure range"
    }
    var clientFinal = ""
    var serverSignature = ""
    if (error == "") {
        val withoutProof = "c=biws,r=$serverNonce"
        val authMessage = "$clientFirstBare,$serverFirst,$withoutProof"
        val saltedPassword = pgPbkdf2Sha256(password, salt, iterations)
        val clientKey = pgHmacSha256(saltedPassword, "Client Key")
        val storedKey = pgSha256(clientKey)
        val clientSignature = pgHmacSha256(storedKey, authMessage)
        val proof = pgBinaryXor(clientKey, clientSignature)
        val serverKey = pgHmacSha256(saltedPassword, "Server Key")
        serverSignature = pgBase64Encode(
            pgHmacSha256(serverKey, authMessage)
        )
        clientFinal = "$withoutProof,p=${pgBase64Encode(proof)}"
    }
    PgScramProof(clientFinal, serverSignature, error)
}

fun pgMd5PasswordResponse(
    user: string,
    password: string,
    salt: string
): string {
    var result = ""
    if (salt.size == 4) {
        val inner = pgHex(pgMd5("$password$user"))
        result = "md5${pgHex(pgMd5("$inner$salt"))}"
    }
    result
}

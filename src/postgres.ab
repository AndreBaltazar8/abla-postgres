// A small PostgreSQL v3 wire-protocol client for Linux Abla services.
//
// The client deliberately uses the extended query protocol. Values are sent
// separately from SQL text, so applications do not need to quote user input.

import "abla/sys/linux/net"
import "abla/sys/linux/process"
import "abla/bytes"
import "abla/dns"
import "abla/text"
import "crypto.ab"

class PgConfig(
    val host: string,
    val port: int,
    val database: string,
    val user: string,
    val password: string,
    val connectTimeoutMilliseconds: int = 3000,
    val readTimeoutMilliseconds: int = 5000,
    // As libpq's: disable, require (encrypted, no check of who answers), verify-ca, verify-full.
    // Anything but disable needs the "tls" subpath: see src/tls.ab. It never falls back to plain text.
    val sslMode: string = "disable",
    // The CA file of verify-ca and verify-full, or "system".
    val sslRootCert: string = "",
    // A candidate must prove it is writable before application SQL is sent.
    val targetSessionAttrs: string = "read-write"
)

// Keep connection policy when giving a dedicated checkpoint/lease session its
// own budgets. Callers should not reconstruct a config positionally as new
// host-selection policy is added.
fun pgConfigWithTimeouts(config: PgConfig, connectMilliseconds: int, readMilliseconds: int): PgConfig = PgConfig(
    config.host,config.port,config.database,config.user,config.password,
    connectMilliseconds,readMilliseconds,config.sslMode,config.sslRootCert,config.targetSessionAttrs
)

class PgCandidate(val host: string, val port: int)

fun pgCandidates(config: PgConfig): array<PgCandidate> {
    val out: array<PgCandidate> = []
    for (part in config.host.split(",")) {
        val text = part.trim()
        val pieces = text.split(":")
        val host = pieces[0].trim()
        val port = if (pieces.size == 2) pgInt(pieces[1].trim()) else config.port
        if (host == "" || pieces.size > 2 || port <= 0 || port > 65535 || out.size >= 32) return []
        out.append(PgCandidate(host,port))
    }
    out
}

fun pgCandidateConfig(config: PgConfig, candidate: PgCandidate, connectMilliseconds: int): PgConfig = PgConfig(
    candidate.host,candidate.port,config.database,config.user,config.password,
    connectMilliseconds,config.readTimeoutMilliseconds,config.sslMode,config.sslRootCert,config.targetSessionAttrs
)

fun pgRemaining(deadline: int, maximum: int): int {
    val left = deadline-linuxMonotonicMilliseconds()
    if (left <= 0) 0 else if (left < maximum) left else maximum
}

// Numeric candidates and /etc/hosts need no resolver process. DNS uses only
// the remaining budget; an unbounded NSS/getent fallback is never used here.
fun pgResolveCandidate(host: string, deadline: int): string {
    if (linuxIpv4Octets(host).size == 4) return host
    if (host == "localhost") return "127.0.0.1"
    for (line in linuxReadFile("/etc/hosts",1048576).split("\n")) {
        val words = line.replace("\t"," ").split(" ")
        var address = ""
        for (word in words) {
            if (word.startsWith("#")) break
            if (word != "") {
                if (address == "") address = word
                else if (word == host && linuxIpv4Octets(address).size == 4) return address
            }
        }
    }
    // dnsResolveType's timeout is per search name. Ask absolute candidates one
    // at a time so a long search-domain list shares the original deadline too.
    val configuration = dnsReadConfiguration()
    for (name in dnsCandidates(host,configuration)) {
        val budget = pgRemaining(deadline,2000)
        if (budget <= 0) return ""
        val result = dnsResolveType("$name.",1,budget)
        for (address in result.addresses) if (address.family == 4) return address.address
        if (!result.succeeded && !result.nameNotFound) return ""
    }
    ""
}

class PgParameter(val value: string, val isNull: bool)

fun pgText(value: string): PgParameter = PgParameter(value, false)

fun pgNull(): PgParameter = PgParameter("", true)

class PgValue(val value: string, val isNull: bool)

class PgResult(
    val succeeded: bool,
    val columns: array<string>,
    val rows: array<array<PgValue>>,
    val command: string,
    val error: string,
    val sqlState: string = "",
    // The request may have committed, but its complete acknowledgement was
    // lost. Resolve with application idempotency; never replay it here.
    val outcomeUnknown: bool = false
) {
    fun first(column: string): string {
        var result = ""
        var index = 0
        while (index < this.columns.size) {
            if (this.columns[index] == column && this.rows.size > 0 &&
                index < this.rows[0].size && !this.rows[0][index].isNull) {
                result = this.rows[0][index].value
            }
            index = index + 1
        }
        result
    }

    fun cell(row: int, column: string): PgValue {
        var result = PgValue("", true)
        var index = 0
        while (index < this.columns.size) {
            if (this.columns[index] == column && row >= 0 &&
                row < this.rows.size && index < this.rows[row].size) {
                result = this.rows[row][index]
            }
            index = index + 1
        }
        result
    }
}

class PgMessage(val kind: int, val body: string, val valid: bool)

// `tls` is the handle of the TLS session that took the connection over, 0 without one.
class PgStream(val connection: TcpConnection, var buffered: string, var tls: int)
// status:1 progress,2 WANT_READ,3 WANT_WRITE,0 EOF,-1 fatal error.
class PgTlsIo(val text: string, val written: int, val status: int)

// What src/tls.ab adds, so that only a program importing it links OpenSSL.
interface PgTls {
    fun upgrade(var connection: TcpConnection, host: string, mode: string, rootCert: string, timeoutMilliseconds: int): int
    fun failure(): string
    fun send(handle: int, bytes: string): int
    fun receive(handle: int, timeoutMilliseconds: int): string
    fun close(handle: int): void
    // Nonblocking pool operations. start leaves fd owned by its caller on
    // failure; a successful handle owns it until close or explicit transfer.
    fun start(descriptor: int, host: string, mode: string, rootCert: string): int
    fun handshake(handle: int): int
    fun sendReady(handle: int, bytes: string, offset: int): PgTlsIo
    fun receiveReady(handle: int, maximum: int): PgTlsIo
    fun sendUntil(handle: int, bytes: string, deadline: int): int
}
val pgTlsAdded: array<PgTls> = []

// A reusable authenticated PostgreSQL session. The server-side HTTP runtime is
// currently single-threaded, so one client can safely serve consecutive
// requests without paying the TCP and authentication cost for every query.
class PgClient(
    val config: PgConfig,
    var stream: PgStream,
    var authenticated: bool,
    var transactionState: int = 0
)

val pgTransactionIdle = 0
val pgTransactionOpen = 1
val pgTransactionFailed = 2
val pgTransactionLost = 3
val pgTransactionUnknown = 4

// Carry the complete logical session, including a disconnected transaction.
// A socket descriptor alone cannot distinguish a fresh connection from a lost
// transaction. Requiring this value prevents old callers dropping that state.
class PgSessionState(
    val descriptor: int = -1,
    val buffered: string = "",
    val transactionState: int = 0
)

class PgSessionResult(
    val state: PgSessionState,
    val result: PgResult
)

fun pgDisconnectedStream(): PgStream = PgStream(TcpConnection(-1), "", 0)

fun pgClient(config: PgConfig): PgClient = PgClient(config, pgDisconnectedStream(), false)

fun pgEnvironment(name: string, fallback: string): string {
    val configured = linuxEnvironment(name)
    if (configured.found && configured.value != "") configured.value else fallback
}

fun pgSecretEnvironment(
    name: string,
    fileName: string,
    fallback: string
): string {
    val direct = linuxEnvironment(name)
    var result = fallback
    if (direct.found) result = direct.value
    else {
        val configuredFile = linuxEnvironment(fileName)
        if (configuredFile.found && configuredFile.value != "") {
            val contents = linuxReadFile(configuredFile.value, 65536)
            var end = contents.size
            while (end > 0 && (contents[end - 1] == 10 ||
                contents[end - 1] == 13)) end = end - 1
            if (end > 0) result = contents.slice(0, end)
        }
    }
    result
}

fun pgParsePositiveInt(value: string, fallback: int): int {
    var parsed = 0
    var valid = value.size > 0
    var index = 0
    while (valid && index < value.size) {
        val digit = value[index] - 48
        if (digit < 0 || digit > 9) valid = false
        else parsed = parsed * 10 + digit
        index = index + 1
    }
    if (valid && parsed > 0) parsed else fallback
}

fun pgInt(value: string, fallback: int = 0): int {
    var parsed = 0
    var sign = 1
    var index = 0
    var valid = value.size > 0
    if (valid && value[0] == 45) {
        sign = -1
        index = 1
        if (index == value.size) valid = false
    }
    while (valid && index < value.size) {
        val digit = value[index] - 48
        if (digit < 0 || digit > 9) valid = false
        else parsed = parsed * 10 + digit
        index = index + 1
    }
    if (valid) parsed * sign else fallback
}

fun pgConfigFromEnvironment(): PgConfig = PgConfig(
    pgEnvironment("POSTGRES_HOST", "127.0.0.1"),
    pgParsePositiveInt(pgEnvironment("POSTGRES_PORT", "5432"), 5432),
    pgEnvironment("POSTGRES_DB", "postgres"),
    pgEnvironment("POSTGRES_USER", "postgres"),
    pgSecretEnvironment("POSTGRES_PASSWORD", "POSTGRES_PASSWORD_FILE", ""),
    pgParsePositiveInt(pgEnvironment("POSTGRES_CONNECT_TIMEOUT_MS", "3000"), 3000),
    pgParsePositiveInt(pgEnvironment("POSTGRES_READ_TIMEOUT_MS", "5000"), 5000),
    pgEnvironment("POSTGRES_SSLMODE", "disable"),
    pgEnvironment("POSTGRES_SSLROOTCERT", ""),
    pgEnvironment("POSTGRES_TARGET_SESSION_ATTRS", "read-write")
)

fun pgAppendU16(var bytes: array<int>, value: int): void {
    bytes.append(value / 256)
    bytes.append(value - value / 256 * 256)
}

fun pgAppendU32(var bytes: array<int>, value: int): void {
    bytes.append(value / 16777216)
    bytes.append(value / 65536 - value / 16777216 * 256)
    bytes.append(value / 256 - value / 65536 * 256)
    bytes.append(value - value / 256 * 256)
}

fun pgAppendText(var bytes: array<int>, value: string): void {
    var index = 0
    while (index < value.size) {
        bytes.append(value[index])
        index = index + 1
    }
}

fun pgAppendCString(var bytes: array<int>, value: string): void {
    pgAppendText(bytes, value)
    bytes.append(0)
}

// Protocol bytes are already numeric. Write one contiguous allocation instead
// of allocating a one-byte string and a chunk entry for every payload byte.
fun pgBytes(bytes: array<int>): string {
    val buffer = nativeByteBuffer(bytes.size + 1)
    var index = 0
    while (index < bytes.size) {
        val value = bytes[index]
        if (value < 0 || value > 255) { buffer.close(); return "" }
        buffer.store(index,value)
        index = index + 1
    }
    buffer.store(bytes.size,0)
    buffer.adoptString(bytes.size)
}

fun pgTypedMessage(kind: int, body: array<int>): string {
    val bytes: array<int> = [kind]
    pgAppendU32(bytes, body.size + 4)
    var index = 0
    while (index < body.size) {
        bytes.append(body[index])
        index = index + 1
    }
    pgBytes(bytes)
}

fun pgReadU16(value: string, offset: int): int =
    value[offset] * 256 + value[offset + 1]

fun pgReadU32(value: string, offset: int): int =
    value[offset] * 16777216 + value[offset + 1] * 65536 +
    value[offset + 2] * 256 + value[offset + 3]

val pgLargestMessage = 16777216
val pgOversizedMessage = -1

// Waits at most `timeoutMilliseconds` for each piece of the message to arrive, so
// neither a slow reply nor a large one runs out while bytes keep coming.
fun PgStream.send(bytes: string): int =
    if (this.tls != 0) pgTlsAdded[0].send(this.tls, bytes) else this.connection.write(bytes)

fun PgStream.sendWithin(bytes: string, deadline: int): int {
    if(deadline<=0) return this.send(bytes)
    if(this.tls!=0) return pgTlsAdded[0].sendUntil(this.tls,bytes,deadline)
    val descriptor=this.connection.descriptor
    if(descriptor<0 || !linuxSocketSetNonblocking(descriptor,true)) return -1
    var offset=0
    var healthy=true
    while(healthy && offset<bytes.size && linuxMonotonicMilliseconds()<deadline) {
        val sent=this.connection.writeCompact(bytes,offset)
        if(sent.written>0) offset=offset+sent.written
        if(sent.status=="error" && sent.errorCode!=11) healthy=false
        else if(offset<bytes.size) {
            val budget=pgRemaining(deadline,10000)
            if(budget<=0) healthy=false
            else {
                val polled=linuxPollSocket(descriptor,false,true,budget)
                if(polled.timedOut || polled.closed || polled.errorCode!=0) healthy=false
            }
        }
    }
    linuxSocketSetNonblocking(descriptor,false)
    if(healthy && offset==bytes.size) offset else -1
}

fun PgStream.next(timeoutMilliseconds: int, deadline: int = 0, maximumMessageBytes: int = pgLargestMessage): PgMessage {
    var enough = this.buffered.size >= 5
    var total = 0
    if (enough) total = 1 + pgReadU32(this.buffered, 1)
    var waiting = true
    while (waiting && (!enough || (total <= maximumMessageBytes && this.buffered.size < total))) {
        val budget = if (deadline > 0) pgRemaining(deadline,timeoutMilliseconds) else timeoutMilliseconds
        if (budget <= 0) return PgMessage(0,"",false)
        val chunk = if (this.tls != 0) pgTlsAdded[0].receive(this.tls, budget)
            else this.connection.readWithTimeoutResult(65536, budget).bytes
        if (chunk.size > 0) this.buffered = "${this.buffered}$chunk"
        else waiting = false
        enough = this.buffered.size >= 5
        if (enough) total = 1 + pgReadU32(this.buffered, 1)
    }
    var result = PgMessage(0, "", false)
    if (enough && total > maximumMessageBytes) result = PgMessage(pgOversizedMessage, "", false)
    else if (enough && total >= 5 && this.buffered.size >= total) {
        result = PgMessage(
            this.buffered[0],
            this.buffered.slice(5, total),
            true
        )
        this.buffered = this.buffered.slice(total, this.buffered.size)
    }
    result
}

/** An IPv4 address for `host`: numeric as-is, "localhost" = 127.0.0.1, else DNS
 *  (resolv.conf — compose service names included), falling back to `getent
 *  ahostsv4` (/etc/hosts, NSS) where that exists. "" = unresolvable. */
fun pgResolveIpv4(host: string): string {
    if (linuxIpv4Octets(host).size == 4) return host
    if (host == "localhost") return "127.0.0.1"
    val resolution = dnsResolveType(host, 1, 2000)
    var index = 0
    while (index < resolution.addresses.size) {
        if (resolution.addresses[index].family == 4) return resolution.addresses[index].address
        index = index + 1
    }
    val command = linuxCommand("getent")
    command.argument("ahostsv4")
    command.argument(host)
    val lookup = command.capture()
    var result = ""
    if (lookup.status == 0) {
        var end = 0
        while (end < lookup.output.size && lookup.output[end] != 32 &&
            lookup.output[end] != 9 && lookup.output[end] != 10) {
            end = end + 1
        }
        if (end > 0) result = lookup.output.slice(0, end)
    }
    result
}

fun pgStartup(config: PgConfig): array<int> {
    val body: array<int> = []
    pgAppendU32(body, 196608)
    pgAppendCString(body, "user")
    pgAppendCString(body, config.user)
    pgAppendCString(body, "database")
    pgAppendCString(body, config.database)
    pgAppendCString(body, "application_name")
    pgAppendCString(body, "abla-postgres")
    body.append(0)
    val packet: array<int> = []
    pgAppendU32(packet, body.size + 4)
    var index = 0
    while (index < body.size) {
        packet.append(body[index])
        index = index + 1
    }
    packet
}

// An ErrorResponse's message, and its DETAIL on a line of its own when it has one, as psql shows them: the detail is often what
// says why (`User does not have CONNECT privilege.`, `Key (id)=(1) already exists.`).
fun pgErrorMessage(body: string): string {
    var message = "PostgreSQL error"
    var detail = ""
    var index = 0
    while (index < body.size && body[index] != 0) {
        val field = body[index]
        index = index + 1
        val begin = index
        while (index < body.size && body[index] != 0) index = index + 1
        if (field == 77) message = body.slice(begin, index)
        else if (field == 68) detail = body.slice(begin, index)
        index = index + 1
    }
    if (detail == "") message else "$message\nDETAIL: $detail"
}

fun pgErrorSqlState(body: string): string {
    var index = 0
    while (index < body.size && body[index] != 0) {
        val field = body[index]
        index = index + 1
        val begin = index
        while (index < body.size && body[index] != 0) index = index + 1
        if (field == 67) return body.slice(begin,index)
        index = index + 1
    }
    ""
}

// Only transaction-control words are examined; quoted text and comments are
// never searched for BEGIN/COMMIT substrings. Extended queries contain exactly
// one statement. Simple-query scripts are handled conservatively separately.
fun pgTransactionControl(sql: string): int {
    val words: array<string> = []
    var index = 0
    while (index < sql.size && words.size < 4) {
        val byte = sql[index]
        if (byte == 32 || byte == 9 || byte == 10 || byte == 11 || byte == 12 || byte == 13) index = index + 1
        else if (index + 1 < sql.size && byte == 45 && sql[index+1] == 45) {
            while (index < sql.size && sql[index] != 10 && sql[index] != 13) index = index + 1
        } else if (index + 1 < sql.size && byte == 47 && sql[index+1] == 42) {
            var depth = 1
            index = index + 2
            while (index < sql.size && depth > 0) {
                if (index+1 < sql.size && sql[index] == 47 && sql[index+1] == 42) { depth = depth + 1; index = index + 2 }
                else if (index+1 < sql.size && sql[index] == 42 && sql[index+1] == 47) { depth = depth - 1; index = index + 2 }
                else index = index + 1
            }
        } else if ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)) {
            val begin = index
            while (index < sql.size && ((sql[index]>=65 && sql[index]<=90) || (sql[index]>=97 && sql[index]<=122))) index = index + 1
            words.append(sql.slice(begin,index).uppercase())
        } else break
    }
    if (words.size == 0) return 0
    if (words[0] == "BEGIN" || (words[0] == "START" && words.size > 1 && words[1] == "TRANSACTION")) return 1
    if (words[0] == "COMMIT" || words[0] == "END" || (words[0] == "PREPARE" && words.size > 1 && words[1] == "TRANSACTION")) return 2
    if (words[0] == "ROLLBACK" || words[0] == "ABORT") {
        for (word in words) if (word == "TO") return 0
        var chain=false
        var noChain=false
        for (word in words) { if (word=="CHAIN") chain=true; if (word=="NO") noChain=true }
        if (chain && !noChain) return 5
        return 3
    }
    0
}

fun pgConnect(config: PgConfig): PgStream {
    val address = pgResolveIpv4(config.host)
    PgStream(
        tcpConnectIpv4(address, config.port, config.connectTimeoutMilliseconds),
        "",
        0
    )
}

fun pgTlsProblem(config: PgConfig): string {
    val mode = config.sslMode
    if (mode == "disable") return ""
    if (mode != "require" && mode != "verify-ca" && mode != "verify-full") return "Unknown PostgreSQL sslmode: $mode"
    if (pgTlsAdded.size == 0) return "sslmode $mode needs TLS, which this program doesn't have: import abla-postgres' tls subpath and call pgTlsEnable()"
    if (mode != "require" && config.sslRootCert == "") return "sslmode $mode needs a CA file to check the server against"
    ""
}

// Asks for TLS before anything else goes over the connection (the protocol's SSLRequest), and takes one byte of the
// answer: anything sent behind it, in the clear, must not be read as if it had come over TLS (CVE-2021-23222).
fun pgTlsNegotiate(var stream: PgStream, config: PgConfig, deadline: int = 0): string {
    if (config.sslMode == "disable" || stream.connection.descriptor < 0) return ""
    if (stream.connection.write("\x00\x00\x00\x08\x04\xd2\x16\x2f") < 0) return "Could not ask PostgreSQL for TLS"
    val readBudget = if (deadline > 0) pgRemaining(deadline,config.readTimeoutMilliseconds) else config.readTimeoutMilliseconds
    if (readBudget <= 0) return "PostgreSQL TLS connection deadline exceeded"
    val answer = stream.connection.readWithTimeoutResult(1, readBudget).bytes
    if (answer != "S") return "PostgreSQL at ${config.host}:${config.port} doesn't offer TLS, and sslmode ${config.sslMode} requires it"
    val tls = pgTlsAdded[0]
    val budget = if (deadline > 0) pgRemaining(deadline,config.connectTimeoutMilliseconds) else config.connectTimeoutMilliseconds
    if (budget <= 0) return "PostgreSQL TLS connection deadline exceeded"
    val handle = tls.upgrade(stream.connection, config.host, config.sslMode, config.sslRootCert, budget)
    if (handle == 0) return "TLS with PostgreSQL at ${config.host}:${config.port} failed under sslmode ${config.sslMode}: ${tls.failure()}"
    stream.tls = handle
    ""
}

fun pgPasswordMessage(value: string): string {
    val body: array<int> = []
    pgAppendCString(body, value)
    pgTypedMessage(112, body)
}

fun pgSaslInitialMessage(initial: string): string {
    val body: array<int> = []
    pgAppendCString(body, "SCRAM-SHA-256")
    pgAppendU32(body, initial.size)
    pgAppendText(body, initial)
    pgTypedMessage(112, body)
}

fun pgSaslResponseMessage(response: string): string {
    val body: array<int> = []
    pgAppendText(body, response)
    pgTypedMessage(112, body)
}

fun pgAuthenticationOffers(body: string, mechanism: string): bool {
    var found = false
    var index = 4
    while (index < body.size && body[index] != 0) {
        val begin = index
        while (index < body.size && body[index] != 0) index = index + 1
        if (body.slice(begin, index) == mechanism) found = true
        index = index + 1
    }
    found
}

fun pgAuthenticate(var stream: PgStream, config: PgConfig, deadline: int = 0): string {
    var error = ""
    if (stream.connection.descriptor < 0 && stream.tls == 0) {
        error = "Could not connect to PostgreSQL at ${config.host}:${config.port}"
    } else if (stream.sendWithin(pgBytes(pgStartup(config)),deadline) < 0) {
        error = "Could not send PostgreSQL startup message"
    } else {
        var ready = false
        var authenticationOk = false
        var passwordResponseSent = false
        var clientFirstBare = ""
        var expectedServerSignature = ""
        var scramVerified = false
        while (!ready && error == "") {
            val message = stream.next(config.readTimeoutMilliseconds,deadline,65536)
            if (!message.valid) error = if(message.kind==pgOversizedMessage) "PostgreSQL authentication message exceeded64KiB" else "Timed out during PostgreSQL startup"
            else if (message.kind == 69) error = pgErrorMessage(message.body)
            else if (message.kind == 82) {
                if (message.body.size < 4) {
                    error = "PostgreSQL sent a malformed authentication message"
                } else {
                    val method = pgReadU32(message.body, 0)
                    if (method == 0) {
                        if (clientFirstBare != "" && !scramVerified) {
                            error = "PostgreSQL completed SCRAM without a verified server proof"
                        } else authenticationOk = true
                    } else if (method == 3) {
                        if (passwordResponseSent) {
                            error = "PostgreSQL requested a duplicate password response"
                        } else {
                            passwordResponseSent = true
                            if (stream.sendWithin(
                                pgPasswordMessage(config.password),deadline
                            ) < 0) error = "Could not send PostgreSQL password"
                        }
                    } else if (method == 5) {
                        if (passwordResponseSent || message.body.size != 8) {
                            error = "PostgreSQL sent an invalid MD5 password challenge"
                        } else {
                            passwordResponseSent = true
                            val response = pgMd5PasswordResponse(
                                config.user,
                                config.password,
                                message.body.slice(4, 8)
                            )
                            if (response == "" || stream.sendWithin(
                                pgPasswordMessage(response),deadline
                            ) < 0) error = "Could not send PostgreSQL MD5 password response"
                        }
                    } else if (method == 10) {
                        if (clientFirstBare != "" ||
                            !pgAuthenticationOffers(
                                message.body, "SCRAM-SHA-256"
                            )) {
                            error = "PostgreSQL did not offer a supported SASL mechanism"
                        } else {
                            val nonce = pgSecureNonce()
                            if (nonce == "") {
                                error = "Could not generate a secure PostgreSQL SCRAM nonce"
                            } else {
                                clientFirstBare =
                                    "n=${pgSaslName(config.user)},r=$nonce"
                                val initial = "n,,$clientFirstBare"
                                if (stream.sendWithin(
                                    pgSaslInitialMessage(initial),deadline
                                ) < 0) error = "Could not begin PostgreSQL SCRAM authentication"
                            }
                        }
                    } else if (method == 11) {
                        if (clientFirstBare == "" ||
                            expectedServerSignature != "") {
                            error = "PostgreSQL sent an unexpected SCRAM continuation"
                        } else {
                            val proof = pgScramProof(
                                config.password,
                                clientFirstBare,
                                message.body.slice(4, message.body.size),"","",deadline
                            )
                            if (proof.error != "") error = proof.error
                            else {
                                expectedServerSignature = proof.serverSignature
                                if (stream.sendWithin(
                                    pgSaslResponseMessage(proof.clientFinal),deadline
                                ) < 0) error = "Could not send PostgreSQL SCRAM proof"
                            }
                        }
                    } else if (method == 12) {
                        if (expectedServerSignature == "") {
                            error = "PostgreSQL sent an unexpected SCRAM final message"
                        } else {
                            val outcome = message.body.slice(4, message.body.size)
                            val serverError = pgScramAttribute(outcome, 101)
                            val verifier = pgScramAttribute(outcome, 118)
                            if (serverError != "") {
                                error = "PostgreSQL SCRAM authentication failed: $serverError"
                            } else if (!constantTimeEquals(
                                verifier, expectedServerSignature
                            )) {
                                error = "PostgreSQL SCRAM server proof verification failed"
                            } else scramVerified = true
                        }
                    } else {
                        error = "PostgreSQL authentication method $method is not supported"
                    }
                }
            } else if (message.kind == 90) {
                if (!authenticationOk) {
                    error = "PostgreSQL became ready before authentication completed"
                } else if (message.body.size != 1 || message.body[0] != 73) error = "PostgreSQL startup did not finish in idle transaction state"
                else ready = true
            }
        }
    }
    error
}

fun pgParseColumns(body: string): array<string> {
    val columns: array<string> = []
    if (body.size >= 2) {
        val count = pgReadU16(body, 0)
        var index = 2
        var column = 0
        while (column < count && index < body.size) {
            val begin = index
            while (index < body.size && body[index] != 0) index = index + 1
            columns.append(body.slice(begin, index))
            index = index + 19
            column = column + 1
        }
    }
    columns
}

fun pgParseRow(body: string): array<PgValue> {
    val row: array<PgValue> = []
    if (body.size >= 2) {
        val count = pgReadU16(body, 0)
        var index = 2
        var column = 0
        while (column < count && index + 4 <= body.size) {
            val length = pgReadU32(body, index)
            index = index + 4
            if (length == 4294967295) row.append(PgValue("", true))
            else if (length >= 0 && index + length <= body.size) {
                row.append(PgValue(body.slice(index, index + length), false))
                index = index + length
            }
            column = column + 1
        }
    }
    row
}

fun pgExtendedQuery(sql: string, parameters: array<PgParameter>): string {
    val parse: array<int> = []
    parse.append(0)
    pgAppendCString(parse, sql)
    pgAppendU16(parse, 0)

    val bind: array<int> = []
    bind.append(0)
    bind.append(0)
    pgAppendU16(bind, 0)
    pgAppendU16(bind, parameters.size)
    var index = 0
    while (index < parameters.size) {
        val parameter = parameters[index]
        if (parameter.isNull) {
            bind.append(255)
            bind.append(255)
            bind.append(255)
            bind.append(255)
        } else {
            pgAppendU32(bind, parameter.value.size)
            pgAppendText(bind, parameter.value)
        }
        index = index + 1
    }
    pgAppendU16(bind, 0)

    val describe: array<int> = [80, 0]
    val execute: array<int> = [0, 0, 0, 0, 0]
    val empty: array<int> = []
    val parsed = pgTypedMessage(80, parse)
    val bound = pgTypedMessage(66, bind)
    val described = pgTypedMessage(68, describe)
    val executed = pgTypedMessage(69, execute)
    val synced = pgTypedMessage(83, empty)
    "$parsed$bound$described$executed$synced"
}

fun PgClient.disconnect(): void {
    if (this.transactionState == pgTransactionOpen || this.transactionState == pgTransactionFailed) this.transactionState = pgTransactionLost
    if (this.stream.tls != 0) pgTlsAdded[0].close(this.stream.tls)
    this.stream.tls = 0
    if (this.stream.connection.descriptor >= 0) this.stream.connection.close()
    this.stream = pgDisconnectedStream()
    this.authenticated = false
    return
}

fun PgClient.connect(): string {
    if (this.transactionState != pgTransactionIdle) return "Cannot reconnect an open or lost PostgreSQL transaction; roll back or close the client first"
    this.disconnect()
    val problem = pgTlsProblem(this.config)
    if (problem != "") return problem
    if (this.config.targetSessionAttrs != "read-write" && this.config.targetSessionAttrs != "any") return "Unknown PostgreSQL target_session_attrs"
    val candidates = pgCandidates(this.config)
    if (candidates.size == 0) return "Invalid PostgreSQL host candidate list (IPv4/DNS host[:port], comma separated)"
    val deadline = linuxMonotonicMilliseconds()+this.config.connectTimeoutMilliseconds
    var error = "PostgreSQL connection deadline exceeded"
    for (index in 0 until candidates.size) {
        val remaining = pgRemaining(deadline,this.config.connectTimeoutMilliseconds)
        if (remaining <= 0) break
        // Reserve a fair part of the one total deadline for later candidates.
        val attemptDeadline = linuxMonotonicMilliseconds()+remaining/(candidates.size-index)
        val candidate = pgCandidateConfig(this.config,candidates[index],remaining)
        val address = pgResolveCandidate(candidate.host,attemptDeadline)
        // tcpConnectIpv4 accepts at most10s per dial; the full selection and
        // authentication deadline may legitimately be longer than one dial.
        val budget = pgRemaining(attemptDeadline,10000)
        if (address == "" || budget <= 0) error = "Could not resolve PostgreSQL candidate within connection deadline"
        else {
            this.stream = PgStream(tcpConnectIpv4(address,candidate.port,budget),"",0)
            error = pgTlsNegotiate(this.stream,candidate,attemptDeadline)
            if (error == "") error = pgAuthenticate(this.stream,candidate,attemptDeadline)
            if (error == "") {
                this.authenticated = true
                if (candidate.targetSessionAttrs == "read-write") {
                    val ready = this.exchange(pgExtendedQuery("SHOW transaction_read_only",[]),pgRemaining(attemptDeadline,candidate.readTimeoutMilliseconds),0,attemptDeadline)
                    if (!ready.succeeded || ready.first("transaction_read_only") != "off") error = "PostgreSQL candidate is not a writable target"
                }
                if (error == "" && linuxMonotonicMilliseconds() < attemptDeadline) return ""
                if (error == "") error = "PostgreSQL connection deadline exceeded"
            }
            this.disconnect()
        }
    }
    error
}

// `timeoutMilliseconds` replaces the configured read timeout for this query's
// reply: a long report needn't raise it for everything else. A query that runs
// out loses the connection, which the next query opens again.
fun PgClient.query(
    sql: string,
    parameters: array<PgParameter> = [],
    timeoutMilliseconds: int = 0
): PgResult {
    val replyTimeout = if (timeoutMilliseconds > 0) timeoutMilliseconds
        else this.config.readTimeoutMilliseconds
    this.exchange(pgExtendedQuery(sql, parameters), replyTimeout, pgTransactionControl(sql))
}

// Several statements in one string, as in a migration file, through the simple
// query protocol: no parameters, and one transaction unless the text has its
// own. The first error stops the rest. The connection is then still inside any
// BEGIN of the text, so close it rather than reuse it after a failure. Columns
// and rows are those of every statement that returned any, together.
fun PgClient.script(
    sql: string,
    timeoutMilliseconds: int = 0
): PgResult {
    val body: array<int> = []
    pgAppendCString(body, sql)
    this.exchange(
        pgTypedMessage(81, body),
        if (timeoutMilliseconds > 0) timeoutMilliseconds
        else this.config.readTimeoutMilliseconds,
        4
    )
}

private fun PgClient.exchange(request: string, replyTimeout: int, control: int, deadline: int = 0): PgResult {
    val before = this.transactionState
    if (before == pgTransactionLost || before == pgTransactionUnknown) {
        val unknown = before == pgTransactionUnknown
        if (control == 3) {
            this.transactionState = pgTransactionIdle
            // This resets a disconnected client. It cannot undo a COMMIT whose
            // acknowledgement was lost, so never claim that outcome rolled back.
            return PgResult(!unknown,[],[],"ROLLBACK",if (unknown) "Transaction outcome is unknown; rollback reset the client only" else "",if (unknown) "08007" else "",unknown)
        }
        return PgResult(false,[],[],"",if (unknown) "PostgreSQL transaction outcome is unknown; resolve it before retrying, then roll back or reset the client" else "PostgreSQL transaction connection was lost; roll back or reset the client",if (unknown) "08007" else "08006",unknown)
    }
    var error = ""
    if (!this.authenticated) error = this.connect()
    if (error != "") return PgResult(false,[],[],"",error,"08001")
    val columns: array<string> = []
    val rows: array<array<PgValue>> = []
    var command = ""
    var sqlState = ""
    var transportFailed = false
    var sent = false
    if (error == "") {
        // Record a possible BEGIN before sending it: losing its ReadyForQuery
        // must not make the next statement an autocommitted write. A script may
        // contain arbitrary transaction boundaries, so loss is conservative.
        if ((control == 1 || control == 4) && before == pgTransactionIdle) this.transactionState = pgTransactionOpen
        sent = true
        if (this.stream.sendWithin(request,deadline) < 0) {
            error = "Could not send PostgreSQL query"
            transportFailed = true
        }
    }
    var ready = false
    // PostgreSQL sends ReadyForQuery after an ordinary SQL error. Drain through
    // it so the persistent connection stays protocol-aligned and reusable.
    while (!ready && !transportFailed) {
        val message = this.stream.next(replyTimeout,deadline)
        if (!message.valid) {
            if (error == "") {
                error = if (message.kind == pgOversizedMessage) "PostgreSQL sent a single message over 16 MiB: return fewer columns per row, or split the aggregate"
                else "Timed out while reading PostgreSQL query result"
            }
            transportFailed = true
        } else if (message.kind == 69) {
            if (error == "") { error = pgErrorMessage(message.body); sqlState = pgErrorSqlState(message.body) }
        }
        else if (message.kind == 84 && error == "") {
            val described = pgParseColumns(message.body)
            var index = 0
            while (index < described.size) {
                columns.append(described[index])
                index = index + 1
            }
        } else if (message.kind == 68 && error == "") {
            rows.append(pgParseRow(message.body))
        } else if (message.kind == 67 && message.body.size > 0 &&
            error == "") {
            command = message.body.slice(0, message.body.size - 1)
        } else if (message.kind == 90) {
            if (message.body.size != 1 || (message.body[0] != 73 && message.body[0] != 84 && message.body[0] != 69)) {
                error = "PostgreSQL sent an invalid transaction state"
                transportFailed = true
            } else {
                this.transactionState = if (message.body[0] == 84) pgTransactionOpen else if (message.body[0] == 69) pgTransactionFailed else pgTransactionIdle
                ready = true
            }
        }
    }
    var unknown = false
    if (transportFailed) {
        unknown = sent && (control == 2 || control == 4 || (before == pgTransactionIdle && control != 1))
        if (before != pgTransactionIdle || (sent && (control == 1 || control == 2 || control == 4))) this.transactionState = if (unknown) pgTransactionUnknown else pgTransactionLost
        this.disconnect()
        if (sqlState == "") sqlState = if (unknown) "08007" else "08006"
    } else if (sqlState == "25006" || sqlState == "57P01" || sqlState == "57P02" || sqlState == "57P03" || sqlState.startsWith("08")) {
        // A demoted/read-only server is not reused. Fail this operation, and
        // select another writable host only for a later new operation.
        if (this.transactionState != pgTransactionIdle) this.transactionState = pgTransactionLost
        this.disconnect()
    }
    if (error == "" && control == 2 && command == "ROLLBACK") {
        error = "PostgreSQL rolled back the failed transaction instead of committing"
        sqlState = "25P02"
    }
    PgResult(error == "" && ready, columns, rows, command, error,sqlState,unknown)
}

fun PgClient.execute(
    sql: string,
    parameters: array<PgParameter> = [],
    timeoutMilliseconds: int = 0
): PgResult = this.query(sql, parameters, timeoutMilliseconds)

fun PgClient.close(): void {
    this.disconnect()
    this.transactionState = pgTransactionIdle
    return
}

// A TLS session's handle, as a descriptor: above any real one.
val pgSessionTls = 4611686018427387904

fun pgSessionQuery(
    config: PgConfig,
    state: PgSessionState,
    sql: string,
    parameters: array<PgParameter> = [],
    timeoutMilliseconds: int = 0
): PgSessionResult {
    val descriptor = state.descriptor
    val buffered = state.buffered
    val client = PgClient(
        config,
        if (descriptor >= pgSessionTls) PgStream(TcpConnection(-1), buffered, descriptor - pgSessionTls)
        else PgStream(TcpConnection(descriptor), buffered, 0),
        descriptor >= 0,
        state.transactionState
    )
    val result = client.query(sql, parameters, timeoutMilliseconds)
    val nextDescriptor = if (client.stream.tls != 0) pgSessionTls + client.stream.tls else client.stream.connection.descriptor
    val nextBuffered = client.stream.buffered
    // The scalar session bridge transfers descriptor ownership back to the
    // caller. Prevent structural cleanup of the temporary client from closing
    // the reusable socket as this function returns.
    client.stream.connection.descriptor = -1
    PgSessionResult(
        PgSessionState(nextDescriptor,nextBuffered,client.transactionState),
        result
    )
}

fun pgQuery(
    config: PgConfig,
    sql: string,
    parameters: array<PgParameter> = [],
    timeoutMilliseconds: int = 0
): PgResult {
    val client = pgClient(config)
    val result = client.query(sql, parameters, timeoutMilliseconds)
    client.close()
    result
}

fun pgExecute(
    config: PgConfig,
    sql: string,
    parameters: array<PgParameter> = [],
    timeoutMilliseconds: int = 0
): PgResult = pgQuery(config, sql, parameters, timeoutMilliseconds)

// TLS for abla-postgres, by its own import:
//     import github("AndreBaltazar8/abla-postgres/tls")
//     pgTlsEnable()
// after which a PgConfig's sslMode, or POSTGRES_SSLMODE and POSTGRES_SSLROOTCERT, ask for it. Without the call, a program
// that asks gets an error saying so, and never a plain connection. The TLS is abla/tls/pure's (no OpenSSL, no libc): one
// TlsSession per connection over the socket the library already used for the SSLRequest exchange.
import "postgres.ab"
import "abla/tls/pure"
import "abla/sys/linux/net"
import "abla/sys/linux"
import "abla/sys/linux/process"

// A session and what the blocking calls (send, receive) bound themselves by. The handle of a session is its descriptor plus
// one, so that 0 can say "no TLS", and the table is the only owner of the descriptor until close.
class PgPureEntry(var session: TlsSession, val handle: int, var timeoutMilliseconds: int)

val pgPureSessions: array<PgPureEntry> = []

private fun pgPureIndex(handle: int): int {
    var at = 0
    while (at < pgPureSessions.size) {
        if (pgPureSessions[at].handle == handle) return at
        at = at + 1
    }
    -1
}

// Only sslmode require encrypts and checks nothing else; verify-ca checks the chain; everything else, verify-full and anything
// unknown, checks the chain and the name (an address is checked as one, against the certificate's IP entries, and is not sent
// as a server name). The direction is the old one: a mode nobody listed is checked.
private fun pgPureMode(mode: string): int =
    if (mode == "require") TLS_VERIFY_NONE else if (mode == "verify-ca") TLS_VERIFY_CHAIN else TLS_VERIFY_HOST

private fun pgPureStatus(status: int): int = if (status == 1 || status == 2 || status == 3 || status == 0) status else -1

class PgPureTls(var reason: string) : PgTls {
    fun start(descriptor: int, host: string, mode: string, rootCert: string): int {
        if (descriptor < 0 || !linuxSocketSetNonblocking(descriptor, true)) {
            this.reason = "the socket could not be made non-blocking"
            return 0
        }
        val session = tlsSessionClient(descriptor, host, pgPureMode(mode), rootCert)
        if (!session.ok()) {
            this.reason = session.detail()
            return 0
        }
        val handle = descriptor + 1
        pgPureSessions.append(PgPureEntry(move(session), handle, 10000))
        handle
    }
    fun handshake(handle: int): int {
        val at = pgPureIndex(handle)
        if (at < 0) return -1
        val status = pgPureSessions[at].session.handshake()
        if (status < 0) this.reason = pgPureSessions[at].session.detail()
        if (status == 1 || status == 2 || status == 3) status else -1
    }
    fun sendReady(handle: int, bytes: string, offset: int): PgTlsIo {
        val at = pgPureIndex(handle)
        if (at < 0) return PgTlsIo("", 0, -1)
        if (offset < 0 || offset >= bytes.size) return PgTlsIo("", 0, 1)
        val sent = pgPureSessions[at].session.writeReady(bytes, offset)
        PgTlsIo("", sent.written, pgPureStatus(sent.status))
    }
    fun receiveReady(handle: int, maximum: int): PgTlsIo {
        val at = pgPureIndex(handle)
        if (at < 0) return PgTlsIo("", 0, -1)
        val read = pgPureSessions[at].session.readReady(maximum)
        PgTlsIo(read.bytes, read.bytes.size, pgPureStatus(read.status))
    }
    fun sendUntil(handle: int, bytes: string, deadline: int): int {
        val at = pgPureIndex(handle)
        if (at < 0) return -1
        val descriptor = pgPureSessions[at].session.descriptor()
        var offset = 0
        var healthy = true
        while (healthy && offset < bytes.size && linuxMonotonicMilliseconds() < deadline) {
            val sent = pgPureSessions[at].session.writeReady(bytes, offset)
            if (sent.written > 0) offset = offset + sent.written
            if (sent.status < 0 || sent.status == 0) healthy = false
            else if (offset < bytes.size && (sent.status == 2 || sent.status == 3)) {
                val budget = pgRemaining(deadline, 10000)
                if (budget <= 0) healthy = false
                else {
                    val polled = linuxPollSocket(descriptor, sent.status == 2, sent.status == 3, budget)
                    if (polled.timedOut || polled.closed || polled.errorCode != 0) healthy = false
                }
            }
        }
        if (healthy && offset == bytes.size) offset else -1
    }
    // As stdlib's tlsUpgrade, which always checks the name: what is checked follows the mode.
    fun upgrade(var connection: TcpConnection, host: string, mode: string, rootCert: string, timeoutMilliseconds: int): int {
        val handle = this.start(connection.descriptor, host, mode, rootCert)
        if (handle == 0) {
            connection.close()
            return 0
        }
        val deadline = linuxMonotonicMilliseconds() + timeoutMilliseconds
        var connected = false
        var waiting = true
        while (waiting && linuxMonotonicMilliseconds() < deadline) {
            val status = this.handshake(handle)
            if (status == 1) { connected = true; waiting = false }
            else if (status != 2 && status != 3) waiting = false
            else {
                val budget = pgRemaining(deadline, timeoutMilliseconds)
                if (budget <= 0) waiting = false
                else {
                    val polled = linuxPollSocket(connection.descriptor, status == 2, status == 3, budget)
                    if (polled.timedOut || polled.errorCode != 0 || polled.closed) waiting = false
                }
            }
        }
        if (!connected) {
            if (this.reason == "") this.reason = "the handshake did not finish in time"
            this.close(handle)
            connection.descriptor = -1
            return 0
        }
        val at = pgPureIndex(handle)
        pgPureSessions[at].timeoutMilliseconds = timeoutMilliseconds
        connection.descriptor = -1
        handle
    }
    fun failure(): string = if (this.reason == "") "the handshake failed, or the server's certificate isn't what was asked for" else this.reason
    // One deadline over every wait of a write, as the socket's own timeout never could for a record in pieces.
    fun send(handle: int, bytes: string): int {
        val at = pgPureIndex(handle)
        if (at < 0) return -1
        val sent = this.sendUntil(handle, bytes, linuxMonotonicMilliseconds() + pgPureSessions[at].timeoutMilliseconds)
        if (sent < 0) -1 else sent
    }
    // One deadline across the waits for the socket, rather than a timeout renewed by each fragment.
    fun receive(handle: int, timeoutMilliseconds: int): string {
        val deadline = linuxMonotonicMilliseconds() + timeoutMilliseconds
        var text = ""
        var waiting = true
        while (waiting && linuxMonotonicMilliseconds() < deadline) {
            val at = pgPureIndex(handle)
            if (at < 0) return ""
            val read = pgPureSessions[at].session.readReady(65536)
            if (read.status == 1 && read.bytes.size > 0) { text = read.bytes; waiting = false }
            else if (read.status != 2 && read.status != 3) waiting = false
            else {
                val budget = pgRemaining(deadline, timeoutMilliseconds)
                if (budget <= 0) waiting = false
                else {
                    val polled = linuxPollSocket(pgPureSessions[at].session.descriptor(), read.status == 2, read.status == 3, budget)
                    if (polled.timedOut || polled.errorCode != 0 || polled.closed) waiting = false
                }
            }
        }
        text
    }
    fun channelBinding(handle: int, kind: string): string {
        val at = pgPureIndex(handle)
        if (at < 0) ""
        else pgPureSessions[at].session.channelBinding(kind)
    }
    // close_notify is offered once and never waited for, then the socket is closed.
    fun close(handle: int): void {
        val at = pgPureIndex(handle)
        if (at < 0) return
        val entry = pgPureSessions.takeAt(at)
        entry.session.close()
        linuxSyscall1(3, entry.session.descriptor())
        return
    }
}

fun pgTlsEnable(): void {
    if (pgTlsAdded.size == 0) pgTlsAdded.append(PgPureTls(""))
    return
}

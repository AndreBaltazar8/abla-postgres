// TLS for abla-postgres, by its own import, as OpenSSL links only into programs that reach it:
//     import github("AndreBaltazar8/abla-postgres/tls")
//     pgTlsEnable()
// after which a PgConfig's sslMode, or POSTGRES_SSLMODE and POSTGRES_SSLROOTCERT, ask for it. Without the call, a program
// that asks gets an error saying so, and never a plain connection.
import "postgres.ab"
import "abla/tls/hosted"
import "abla/sys/linux/net"

trusted noescape extern:"c" fun SSL_get0_param(session: i64*): i64*
trusted noescape extern:"c" fun X509_VERIFY_PARAM_set1_ip_asc(parameters: i64*, address: cstring): i32

private fun pgTlsIsAddress(host: string): bool {
    for (c in host) if (!((c >= 48 && c <= 57) || c == 46 || c == 58)) return false
    true
}

trusted fun pgTlsStart(descriptor: int, host: string, mode: string, rootCert: string): int {
    val checks = mode != "require"
    val context = SSL_CTX_new(TLS_client_method())
    var ready = !pointerIsNull(context)
    if (ready) {
        SSL_CTX_set_verify(context,if(checks) 1 else 0,nativeNullPointer())
        if (checks) ready = (if(rootCert=="system") SSL_CTX_set_default_verify_paths(context) else SSL_CTX_load_verify_locations(context,rootCert,nativeNullPointer())) == 1
    }
    val session = if(ready) SSL_new(context) else nativeNullPointer()
    ready = ready && !pointerIsNull(session)
    // Retry contents remain identical after WANT_READ/WRITE, but Abla may
    // materialize a new C-string buffer for that same slice on the next tick.
    if(ready) ready = (SSL_ctrl(session,33,2,"") & 2) == 2
    val address = pgTlsIsAddress(host)
    if(ready && !address) ready = SSL_ctrl(session,55,0,host) == 1
    if(ready && mode=="verify-full") ready = if(address) X509_VERIFY_PARAM_set1_ip_asc(SSL_get0_param(session),host) == 1 else SSL_set1_host(session,host) == 1
    if(ready) ready = SSL_set_fd(session,descriptor) == 1 && linuxSocketSetNonblocking(descriptor,true)
    if(!ready) {
        if(!pointerIsNull(session)) SSL_free(session)
        if(!pointerIsNull(context)) SSL_CTX_free(context)
        return 0
    }
    tlsAllocateConnection(context,session,descriptor,true)
}

trusted fun pgTlsHandshakeReady(handle: int): int {
    val session = tlsControlPointer(handle,8)
    ERR_clear_error()
    val held = linuxBrokenPipeHold()
    val result: int = SSL_connect(session)
    val reason: int = SSL_get_error(session,i32(result))
    val status = if(result==1) 1 else reason
    linuxBrokenPipeRelease(held)
    if(result==1) 1 else if(status==2 || status==3) status else -1
}

trusted fun pgTlsSendReady(handle: int, bytes: string, offset: int): PgTlsIo {
    if(offset<0 || offset>=bytes.size) return PgTlsIo("",0,1)
    val session = tlsControlPointer(handle,8)
    val count = if(bytes.size-offset>1048576) 1048576 else bytes.size-offset
    ERR_clear_error()
    val held = linuxBrokenPipeHold()
    val sent: int = SSL_write(session,bytes.slice(offset,offset+count),i32(count))
    val reason: int = SSL_get_error(session,i32(sent))
    val status = if(sent>0) 1 else reason
    linuxBrokenPipeRelease(held)
    PgTlsIo("",if(sent>0) sent else 0,if(sent>0) 1 else if(status==2 || status==3) status else -1)
}

trusted fun pgTlsReadReady(handle: int, maximum: int): PgTlsIo {
    val buffer = nativeByteBuffer(maximum)
    val session = tlsControlPointer(handle,8)
    ERR_clear_error()
    val held = linuxBrokenPipeHold()
    val count: int = SSL_read(session,buffer.address,i32(maximum))
    val reason: int = SSL_get_error(session,i32(count))
    val status = if(count>0) 1 else reason
    linuxBrokenPipeRelease(held)
    if(count>0) return PgTlsIo(buffer.adoptString(count),count,1)
    buffer.close()
    PgTlsIo("",0,if(status==2 || status==3) status else if(status==6) 0 else -1)
}

trusted fun pgTlsSendUntil(handle: int, bytes: string, deadline: int): int {
    val descriptor=tlsControlInt(handle,16)
    if(!linuxSocketSetNonblocking(descriptor,true)) return -1
    // SSL_MODE_ACCEPT_MOVING_WRITE_BUFFER for identical slices across retries.
    SSL_ctrl(tlsControlPointer(handle,8),33,2,"")
    var offset=0
    var healthy=true
    while(healthy && offset<bytes.size && linuxMonotonicMilliseconds()<deadline) {
        val sent=pgTlsSendReady(handle,bytes,offset)
        if(sent.written>0) offset=offset+sent.written
        if(sent.status<0 || sent.status==0) healthy=false
        else if(offset<bytes.size && (sent.status==2 || sent.status==3)) {
            val budget=pgRemaining(deadline,10000)
            if(budget<=0) healthy=false
            else {
                val polled=linuxPollSocket(descriptor,sent.status==2,sent.status==3,budget)
                if(polled.timedOut || polled.closed || polled.errorCode!=0) healthy=false
            }
        }
    }
    linuxSocketSetNonblocking(descriptor,false)
    if(healthy && offset==bytes.size) offset else -1
}

// As stdlib's tlsUpgrade, which always checks the name: what is checked follows the mode. An address is checked as one,
// which is what a certificate's IP entries are for, and isn't sent as a server name, as RFC 6066 has only names there.
trusted fun pgTlsHandshake(var connection: TcpConnection, host: string, mode: string, rootCert: string, timeoutMilliseconds: int): int {
    val checks = mode != "require"
    val context = SSL_CTX_new(TLS_client_method())
    var ready = !pointerIsNull(context)
    if (ready) {
        SSL_CTX_set_verify(context, if (checks) 1 else 0, nativeNullPointer())
        if (checks) ready = (if (rootCert == "system") SSL_CTX_set_default_verify_paths(context) else SSL_CTX_load_verify_locations(context, rootCert, nativeNullPointer())) == 1
    }
    val session = if (ready) SSL_new(context) else nativeNullPointer()
    ready = ready && !pointerIsNull(session)
    val address = pgTlsIsAddress(host)
    if (ready && !address) ready = SSL_ctrl(session, 55, 0, host) == 1
    if (ready && mode == "verify-full") {
        ready = if (address) X509_VERIFY_PARAM_set1_ip_asc(SSL_get0_param(session), host) == 1 else SSL_set1_host(session, host) == 1
    }
    if (ready) ready = SSL_set_fd(session, connection.descriptor) == 1
    if (ready) {
        linuxSocketSetTimeouts(connection.descriptor, timeoutMilliseconds, timeoutMilliseconds)
        ready = linuxSocketSetNonblocking(connection.descriptor,true)
    }
    if (ready) {
        val deadline = linuxMonotonicMilliseconds()+timeoutMilliseconds
        ERR_clear_error()
        val held = linuxBrokenPipeHold()
        var connected = false
        var waiting = true
        while (waiting && linuxMonotonicMilliseconds() < deadline) {
            val result = SSL_connect(session)
            if (result == 1) { connected = true; waiting = false }
            else {
                val reason = SSL_get_error(session,result)
                if (reason != 2 && reason != 3) waiting = false
                else {
                    val budget = pgRemaining(deadline,timeoutMilliseconds)
                    if (budget <= 0) waiting = false
                    else {
                        val polled = linuxPollSocket(connection.descriptor,reason == 2,reason == 3,budget)
                        if (polled.timedOut || polled.errorCode != 0 || polled.closed) waiting = false
                    }
                }
            }
        }
        ready = connected && linuxSocketSetNonblocking(connection.descriptor,false)
        linuxBrokenPipeRelease(held)
    }
    if (ready && checks) ready = SSL_get_verify_result(session) == 0
    if (!ready) {
        if (!pointerIsNull(session)) SSL_free(session)
        if (!pointerIsNull(context)) SSL_CTX_free(context)
        connection.close()
        return 0
    }
    val handle = tlsAllocateConnection(context, session, connection.descriptor, true)
    connection.descriptor = -1
    handle
}

// SSL_read can wait for a whole TLS record even when encrypted bytes arrive a
// little at a time. Nonblocking reads enforce one deadline across WANT_READ /
// WANT_WRITE, rather than resetting a socket timeout for each fragment.
trusted fun pgTlsReceive(handle: int, timeoutMilliseconds: int): string {
    val descriptor = tlsControlInt(handle,16)
    if (!linuxSocketSetNonblocking(descriptor,true)) return ""
    val deadline = linuxMonotonicMilliseconds()+timeoutMilliseconds
    val session = tlsControlPointer(handle,8)
    val buffer = nativeByteBuffer(65536)
    val held = linuxBrokenPipeHold()
    var measured: int = 0
    var waiting = true
    while (waiting && linuxMonotonicMilliseconds() < deadline) {
        ERR_clear_error()
        measured = SSL_read(session,buffer.address,65536)
        if (measured > 0) waiting = false
        else {
            val reason = SSL_get_error(session,i32(measured))
            if (reason != 2 && reason != 3) waiting = false
            else {
                val budget = pgRemaining(deadline,timeoutMilliseconds)
                if (budget <= 0) waiting = false
                else {
                    val polled = linuxPollSocket(descriptor,reason == 2,reason == 3,budget)
                    if (polled.timedOut || polled.errorCode != 0 || polled.closed) waiting = false
                }
            }
        }
    }
    linuxSocketSetNonblocking(descriptor,false)
    linuxBrokenPipeRelease(held)
    if (measured > 0) buffer.adoptString(measured) else { buffer.close(); "" }
}

class PgOpenSsl() : PgTls {
    fun start(descriptor: int, host: string, mode: string, rootCert: string): int = pgTlsStart(descriptor,host,mode,rootCert)
    fun handshake(handle: int): int = pgTlsHandshakeReady(handle)
    fun sendReady(handle: int, bytes: string, offset: int): PgTlsIo = pgTlsSendReady(handle,bytes,offset)
    fun receiveReady(handle: int, maximum: int): PgTlsIo = pgTlsReadReady(handle,maximum)
    fun sendUntil(handle: int, bytes: string, deadline: int): int = pgTlsSendUntil(handle,bytes,deadline)
    fun upgrade(var connection: TcpConnection, host: string, mode: string, rootCert: string, timeoutMilliseconds: int): int =
        pgTlsHandshake(connection, host, mode, rootCert, timeoutMilliseconds)
    fun failure(): string = "the handshake failed, or the server's certificate isn't what was asked for"
    fun send(handle: int, bytes: string): int {
        var connection = TlsConnection(handle)
        val sent = connection.write(bytes)
        connection.handle = -1
        sent
    }
    fun receive(handle: int, timeoutMilliseconds: int): string = pgTlsReceive(handle,timeoutMilliseconds)
    fun close(handle: int): void {
        // SSL_shutdown may otherwise block after a failed bounded operation
        // restored blocking mode. Teardown sends close_notify best-effort only.
        val descriptor=tlsControlInt(handle,16)
        if(!linuxSocketSetNonblocking(descriptor,true)) linuxSyscall2(48,descriptor,2)
        var connection = TlsConnection(handle)
        connection.close()
        return
    }
}

fun pgTlsEnable(): void {
    if (pgTlsAdded.size == 0) pgTlsAdded.append(PgOpenSsl())
    return
}
